# Currencing - Cryptocurrency Intelligence & Statistics Telegram Bot Configuration

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Bot Username (any format is automatically sanitized):
# TELEGRAM_BOT_USERNAME=@CurrencingBot
# TELEGRAM_BOT_USERNAME=t.me/CurrencingBot
# TELEGRAM_BOT_USERNAME=CurrencingBot
TELEGRAM_BOT_USERNAME=@CurrencingBot

# Force Join Channels & Groups (comma-separated):
# Users must join these before accessing the bot.
# Supports @username, t.me/link, or https://t.me/link:
# FORCE_JOINS=t.me/channel1, @group2, https://t.me/channel3
FORCE_JOINS=@CurrencingNews, t.me/CurrencingChat

# Persistent SQLite Database Path
DB_PATH=data/currencing_bot.db

# Cache Settings (in seconds)
CACHE_TTL_SECONDS=60
BACKGROUND_SYNC_INTERVAL=120
